<?xml version="1.0" encoding="utf-8"?>
<!-- 4×2 "Bugünün rutinleri" — tasarım: Widgetlar.dc.html, üçüncü kart.
     Başlık: tekrar ikonu + başlık + seri rozeti (alev + gün) + tamamlama
     sayacı; altında sayacı yansıtan ince ilerleme çubuğu; sonra üç rutin
     satırı (onay dairesi + başlık + saat); taşarsa "+N rutin daha".

     Başlığa dokun → Rutinler ekranı. Satıra dokun → anında işaretle
     (uygulama açılmaz).

     İlerleme çubuğu tema başına AYRI: RemoteViews'te progressDrawable çalışma
     anında değiştirilemiyor, o yüzden iki ProgressBar'dan biri gösteriliyor.

     Satır sayısı sabit (3, tasarımdaki gibi) — RemoteViews'te dinamik liste
     ayrı bir Service isterdi, bu boyutta gereksiz. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="3dp">

    <LinearLayout
        android:id="@+id/rt_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
    android:background="@drawable/widget_surface_light"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:id="@+id/rt_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/rt_header_icon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_widget_repeat"
            android:contentDescription="@string/widget_routines_label" />

        <TextView
            android:id="@+id/rt_header_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/widget_routines_label"
            android:fontFamily="@font/instrument_sans_semibold"
            android:textColor="#1B1713"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <LinearLayout
            android:id="@+id/rt_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_pill_light"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="6dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <ImageView
                android:id="@+id/rt_flame"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:src="@drawable/ic_widget_flame"
                android:contentDescription="@string/widget_routines_label" />

            <TextView
                android:id="@+id/rt_streak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/widget_preview_streak"
                android:fontFamily="@font/instrument_sans_semibold"
                android:textColor="#1B2A42"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/rt_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/widget_preview_progress"
            android:fontFamily="@font/instrument_sans_semibold"
            android:textColor="#1B1713"
            android:textSize="12sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/rt_bar_light"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="6dp"
        android:minHeight="4dp"
        android:maxHeight="4dp"
        android:max="100"
        android:progress="40"
        android:indeterminate="false"
        android:progressDrawable="@drawable/widget_progress_light" />

    <ProgressBar
        android:id="@+id/rt_bar_dark"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="6dp"
        android:minHeight="4dp"
        android:maxHeight="4dp"
        android:max="100"
        android:progress="40"
        android:indeterminate="false"
        android:visibility="gone"
        android:progressDrawable="@drawable/widget_progress_dark" />

    <TextView
        android:id="@+id/rt_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/widget_routines_empty"
        android:fontFamily="@font/instrument_sans_regular"
        android:textColor="#8B8377"
        android:textSize="11.5sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/rt_row_0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:minHeight="25dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/rt_check_0"
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:padding="2dp"
            android:background="@drawable/widget_check_fill_light"
            android:src="@drawable/ic_widget_check"
            android:contentDescription="@string/widget_routines_label" />

        <TextView
            android:id="@+id/rt_title_0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="@string/widget_preview_routine_1"
            android:fontFamily="@font/instrument_sans_regular"
            android:textColor="#8B8377"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/rt_time_0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/widget_preview_rtime_1"
            android:fontFamily="@font/instrument_sans_regular"
            android:textColor="#8B8377"
            android:textSize="10.5sp"
            android:maxLines="1" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rt_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:minHeight="25dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/rt_check_1"
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:padding="2dp"
            android:background="@drawable/widget_check_fill_light"
            android:src="@drawable/ic_widget_check"
            android:contentDescription="@string/widget_routines_label" />

        <TextView
            android:id="@+id/rt_title_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="@string/widget_preview_routine_2"
            android:fontFamily="@font/instrument_sans_regular"
            android:textColor="#8B8377"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/rt_time_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/widget_preview_rtime_2"
            android:fontFamily="@font/instrument_sans_regular"
            android:textColor="#8B8377"
            android:textSize="10.5sp"
            android:maxLines="1" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rt_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:minHeight="25dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/rt_check_2"
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:padding="2dp"
            android:background="@drawable/widget_check_ring_light"
            android:src="@drawable/ic_widget_check"
            android:contentDescription="@string/widget_routines_label" />

        <TextView
            android:id="@+id/rt_title_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="@string/widget_preview_routine_3"
            android:fontFamily="@font/instrument_sans_regular"
            android:textColor="#1B1713"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/rt_time_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/widget_preview_rtime_3"
            android:fontFamily="@font/instrument_sans_regular"
            android:textColor="#8B8377"
            android:textSize="10.5sp"
            android:maxLines="1" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rt_more"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/rt_more_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/instrument_sans_regular"
            android:textColor="#7C7468"
            android:textSize="10.5sp"
            android:maxLines="1" />

        <ImageView
            android:id="@+id/rt_more_icon"
            android:layout_width="11dp"
            android:layout_height="11dp"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_widget_chevron"
            android:contentDescription="@string/widget_routines_label" />
    </LinearLayout>
</LinearLayout>
</FrameLayout>
