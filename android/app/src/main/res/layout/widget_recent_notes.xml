<?xml version="1.0" encoding="utf-8"?>
<!-- 4×2 "Son notlar" — tasarım: Widgetlar.dc.html, dördüncü kart.
     Başlık: logo işareti + "Son notlar" + accent dolgulu "+" düğmesi.
     Gövde: en son düzenlenen 4 belge, **2×2 ızgarada** iç kartlar. Her kart:
     tür (not → çizgi belge ikonu, PDF → "PDF" rozeti) + başlık, altında
     "klasör · zaman".

     Karta dokun → belge açılır; `+` → yeni not; başlığa dokun → kütüphane.
     Kilitli notlar bu listeye HİÇ girmez (bkz. widget_data.dart). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="3dp">

    <LinearLayout
        android:id="@+id/rc_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
    android:background="@drawable/widget_surface_light"
    android:orientation="vertical"
    android:paddingStart="13dp"
    android:paddingEnd="13dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:id="@+id/rc_logo"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:background="@drawable/widget_logo_light">

            <ImageView
                android:id="@+id/rc_logo_icon"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_widget_logo"
                android:contentDescription="@string/widget_app_name" />
        </FrameLayout>

        <TextView
            android:id="@+id/rc_header_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/widget_recent_label"
            android:fontFamily="@font/instrument_sans_semibold"
            android:textColor="#1B1713"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <FrameLayout
            android:id="@+id/rc_add"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/widget_addbtn_light">

            <ImageView
                android:id="@+id/rc_add_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_widget_plus"
                android:contentDescription="@string/widget_quick_note_label" />
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/rc_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/widget_recent_empty"
        android:fontFamily="@font/instrument_sans_regular"
        android:textColor="#8B8377"
        android:textSize="11.5sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/rc_grid_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/rc_card_0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:minHeight="40dp"
            android:background="@drawable/widget_inner_light"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/rc_icon_0"
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:src="@drawable/ic_widget_doc"
                    android:contentDescription="@string/widget_recent_label" />

                <TextView
                    android:id="@+id/rc_badge_0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/widget_badge_light"
                    android:paddingStart="3dp"
                    android:paddingEnd="3dp"
                    android:text="@string/widget_pdf_badge"
                    android:fontFamily="@font/instrument_sans_semibold"
                    android:textColor="#1B2A42"
                    android:textSize="7sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/rc_title_0"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="@string/widget_preview_note_1"
                    android:fontFamily="@font/instrument_sans_semibold"
                    android:textColor="#1B1713"
                    android:textSize="11.5sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <TextView
                android:id="@+id/rc_meta_0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/widget_preview_meta_1"
                android:fontFamily="@font/instrument_sans_regular"
                android:textColor="#8B8377"
                android:textSize="9sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rc_card_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:minHeight="40dp"
            android:background="@drawable/widget_inner_light"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/rc_icon_1"
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:src="@drawable/ic_widget_doc"
                    android:visibility="gone"
                    android:contentDescription="@string/widget_recent_label" />

                <TextView
                    android:id="@+id/rc_badge_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/widget_badge_light"
                    android:paddingStart="3dp"
                    android:paddingEnd="3dp"
                    android:text="@string/widget_pdf_badge"
                    android:fontFamily="@font/instrument_sans_semibold"
                    android:textColor="#1B2A42"
                    android:textSize="7sp" />

                <TextView
                    android:id="@+id/rc_title_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="@string/widget_preview_note_2"
                    android:fontFamily="@font/instrument_sans_semibold"
                    android:textColor="#1B1713"
                    android:textSize="11.5sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <TextView
                android:id="@+id/rc_meta_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/widget_preview_meta_2"
                android:fontFamily="@font/instrument_sans_regular"
                android:textColor="#8B8377"
                android:textSize="9sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rc_grid_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/rc_card_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:minHeight="40dp"
            android:background="@drawable/widget_inner_light"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/rc_icon_2"
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:src="@drawable/ic_widget_doc"
                    android:contentDescription="@string/widget_recent_label" />

                <TextView
                    android:id="@+id/rc_badge_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/widget_badge_light"
                    android:paddingStart="3dp"
                    android:paddingEnd="3dp"
                    android:text="@string/widget_pdf_badge"
                    android:fontFamily="@font/instrument_sans_semibold"
                    android:textColor="#1B2A42"
                    android:textSize="7sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/rc_title_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="@string/widget_preview_note_3"
                    android:fontFamily="@font/instrument_sans_semibold"
                    android:textColor="#1B1713"
                    android:textSize="11.5sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <TextView
                android:id="@+id/rc_meta_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/widget_preview_meta_3"
                android:fontFamily="@font/instrument_sans_regular"
                android:textColor="#8B8377"
                android:textSize="9sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rc_card_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:minHeight="40dp"
            android:background="@drawable/widget_inner_light"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/rc_icon_3"
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:src="@drawable/ic_widget_doc"
                    android:contentDescription="@string/widget_recent_label" />

                <TextView
                    android:id="@+id/rc_badge_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/widget_badge_light"
                    android:paddingStart="3dp"
                    android:paddingEnd="3dp"
                    android:text="@string/widget_pdf_badge"
                    android:fontFamily="@font/instrument_sans_semibold"
                    android:textColor="#1B2A42"
                    android:textSize="7sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/rc_title_3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="@string/widget_preview_note_4"
                    android:fontFamily="@font/instrument_sans_semibold"
                    android:textColor="#1B1713"
                    android:textSize="11.5sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <TextView
                android:id="@+id/rc_meta_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/widget_preview_meta_4"
                android:fontFamily="@font/instrument_sans_regular"
                android:textColor="#8B8377"
                android:textSize="9sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
</FrameLayout>
